# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lostlink?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_lostlink_2026
JWT_EXPIRES_IN=7d

# Cloudinary (Optional for cloud media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# Matching Engine Threshold (0-100)
MATCH_THRESHOLD=40
